# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/nav
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace_with_your_postgresql_password
SOURCE_DATABASE_URL=jdbc:postgresql://localhost:5432/nav_map_db
# Destructive Guangzhou import is disabled unless explicitly set to: replace
GUANGZHOU_IMPORT_CONFIRM=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
# Fixed-grid POI cache level. z=9 is tuned for the current Guangzhou dataset.
CACHE_POI_SPATIAL_ZOOM=9

# Spring Boot HTTP port
SERVER_PORT=8080

# Docker Compose (host ports use 5433/6380 to avoid local PostgreSQL/Redis)
POSTGRES_PASSWORD=replace_with_a_strong_docker_password
POSTGRES_PORT=5433
REDIS_PUBLIC_PORT=6380
API_PORT=8080
